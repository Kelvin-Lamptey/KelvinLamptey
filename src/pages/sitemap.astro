---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/Navbar.vue"
import Footer from "../components/Footer.astro"

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order)
---

<Layout title="Sitemap | Kelvin N.O. Lamptey" description="Browse Kelvin N.O. Lamptey's portfolio, background, contact details, and project case studies." socialTitle="Kelvin N.O. Lamptey">
  <Navbar client:load />
  <main class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-text-inverse">Navigation</p>
    <h1 class="mt-3 text-3xl font-bold text-text-secondary sm:text-4xl">Sitemap</h1>
    <div class="mt-10 grid gap-12 sm:grid-cols-2">
      <section>
        <h2 class="text-xl font-bold text-text-secondary">Portfolio</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="/" class="text-text-inverse hover:text-surface-raised">Home</a></li>
          <li><a href="/#projects" class="text-text-inverse hover:text-surface-raised">Projects</a></li>
          <li><a href="/#about" class="text-text-inverse hover:text-surface-raised">About</a></li>
          <li><a href="/#contact" class="text-text-inverse hover:text-surface-raised">Contact</a></li>
        </ul>
      </section>
      <section>
        <h2 class="text-xl font-bold text-text-secondary">Project Case Studies</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {projects.map((project) => <li><a href={`/projects/${project.id}/`} class="text-text-inverse hover:text-surface-raised">{project.data.title}</a></li>)}
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
