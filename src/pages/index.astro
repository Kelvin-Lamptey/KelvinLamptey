---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/Navbar.vue"
import Footer from "../components/Footer.astro"
import ProjectCard from "../components/ProjectCard.vue"
import ContactForm from "../components/ContactForm.vue"
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import heroImage from "../assets/hero-typing.jpg"
import yangoAwardImage from "../assets/yango-award.jpg"
import eventImage from "../assets/event-google-accra.jpg"
import formalStandingImage from "../assets/formal-standing.jpg"
import linkedinWhiteIcon from "../assets/linkedin-white.svg"
import whatsappBlueIcon from "../assets/whatsapp-blue.svg"

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
const techStackIcons: Record<string, string> = {
  PHP: "php", WordPress: "wordpress", WooCommerce: "woocommerce", HTML: "html5", CSS: "css3",
  Go: "go", Docker: "docker", "Vue.js": "vuedotjs", PostgreSQL: "postgresql", "Node.js": "nodedotjs",
  React: "react", "React Native": "react", Expo: "expo", TypeScript: "typescript", "Bun Workspaces": "bun",
  Express: "express", "Prisma ORM": "prisma", Processing: "processing", Java: "openjdk", Python: "python",
  Django: "https://api.iconify.design/skill-icons/django.svg", HTMX: "htmx", NestJS: "nestjs", "Azure Face": "https://api.iconify.design/logos/microsoft-azure.svg", Supabase: "supabase", JavaScript: "javascript",
  CSS: "https://api.iconify.design/skill-icons/css.svg", Processing: "https://api.iconify.design/logos/processing.svg",
}
const techStacks = [...new Set(projects.flatMap((project) => project.data.techStack ?? []))]
const keywords = ["Kelvin N.O. Lamptey", "Kelvin Lamptey", "GCTU", "Ghana Communication Technology University", "Accra", "Ghana", "software engineer", "CTO", "systems engineer", "KENOL Tech", "Yango STEM Fellow", "cloud infrastructure", "DevOps", "SaaS", "full-stack development", "Vue.js", "Docker", "PostgreSQL", "African technology"]
const structuredData = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Kelvin N.O. Lamptey", url: "https://kelvinlamptey.com/" },
  { "@context": "https://schema.org", "@type": "Person", name: "Kelvin N.O. Lamptey", url: "https://kelvinlamptey.com/", jobTitle: "Software Engineer and CTO", address: { "@type": "PostalAddress", addressLocality: "Accra", addressCountry: "GH" }, alumniOf: { "@type": "CollegeOrUniversity", name: "Ghana Communication Technology University" }, worksFor: { "@type": "Organization", name: "KENOL Tech" }, sameAs: ["https://github.com/kelvin-lamptey", "https://linkedin.com/in/kelvin-lamptey", "https://www.instagram.com/kelvinodarteylamptey", "https://x.com/kelvinolamptey", "https://www.youtube.com/@kelvin-lamptey", "https://www.trendshub.live/kelvinlamptey", "https://www.tiktok.com/@kelvinodarteylamptey", "https://www.facebook.com/kelvinniilamptey7", "https://www.threads.net/@kelvinodarteylamptey"], contactPoint: { "@type": "ContactPoint", contactType: "professional inquiries", url: "https://wa.me/kelvinlamptey" } },
]
---

<Layout
  title="Kelvin N.O. Lamptey | CTO & Systems Engineer"
  description="I build scalable, high-impact systems for African tech ecosystems — from cloud platforms and hosting infrastructure to educational tools that democratize learning."
  keywords={keywords}
  structuredData={structuredData}
>
  <Navbar client:load />

  <main>
    <section id="home" class="mx-auto grid min-h-[calc(100svh-73px)] max-w-6xl items-center gap-12 px-6 py-14 sm:py-20 lg:grid-cols-[minmax(0,0.9fr)_minmax(360px,1.1fr)] lg:gap-16 lg:py-16">
      <div class="order-2 lg:order-1 hero-reveal">
        <p class="hero-reveal-item text-sm font-bold uppercase tracking-[0.18em] text-text-inverse">Software engineer · Accra, Ghana</p>
        <h1 class="hero-reveal-item hero-reveal-item--1 mt-5 max-w-3xl text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-text-secondary sm:text-5xl lg:text-6xl">
          Kelvin N.O. Lamptey
        </h1>
        <p class="hero-reveal-item hero-reveal-item--2 mt-6 max-w-xl text-lg font-semibold leading-snug text-text-inverse sm:text-xl">
          Yango STEM Fellow &amp; CTO @ KENOL Tech
        </p>
        <p class="hero-reveal-item hero-reveal-item--3 mt-6 max-w-xl text-base leading-relaxed text-text-primary sm:text-lg">
          I build scalable, high-impact systems for African tech ecosystems, from
          cloud platforms and hosting infrastructure to educational tools that
          democratize learning. My work bridges full-stack engineering, DevOps,
          and product strategy to ship production-grade solutions that solve real
          problems.
        </p>
        <div class="hero-reveal-item hero-reveal-item--4 mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://www.linkedin.com/in/kelvin-lamptey"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 rounded-xs bg-text-inverse px-6 py-3 text-sm font-bold text-surface-muted shadow-sm transition-colors hover:bg-surface-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-inverse"
          >
            <Image src={linkedinWhiteIcon} alt="" aria-hidden="true" width={20} height={20} />
            Connect with me on LinkedIn
          </a>
          <a
            href="https://wa.me/kelvinlamptey"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 rounded-xs border-2 border-text-inverse px-6 py-[11px] text-sm font-bold text-text-inverse transition-colors hover:bg-text-inverse hover:text-surface-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-inverse"
          >
            <Image src={whatsappBlueIcon} alt="" aria-hidden="true" width={20} height={20} class="group-hover:brightness-0 group-hover:invert" />
            Chat with me on WhatsApp
          </a>
        </div>
      </div>
      <div class="relative order-1 lg:order-2 hero-reveal hero-reveal--media">
        <div class="absolute -inset-3 -z-10 translate-x-3 translate-y-3 rounded-xs bg-text-inverse/10 sm:-inset-4 sm:translate-x-5 sm:translate-y-5" aria-hidden="true"></div>
        <figure class="relative overflow-hidden rounded-xs bg-black/[.04] shadow-xl">
          <Image
            src={heroImage}
            alt="Kelvin N.O. Lamptey working at a computer"
            width={1200}
            height={1400}
            format="webp"
            class="h-[min(78vw,620px)] w-full object-cover object-[center_42%] transition-transform duration-700 ease-out hover:scale-[1.02] sm:h-[min(70vw,680px)] lg:h-[min(78vh,680px)]"
          />
          <figcaption class="absolute bottom-0 left-0 right-0 bg-text-secondary/90 px-5 py-4 text-sm font-semibold text-surface-muted backdrop-blur-sm">
            Building useful technology for Africa
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="tech-stacks" class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-text-inverse">Tools of the trade</p>
        <h2 class="mt-3 text-2xl font-bold text-text-secondary sm:text-3xl">Tech Stacks</h2>
        <p class="mt-4 text-sm leading-relaxed text-text-primary sm:text-base">
          A cross-project view of the languages, frameworks, platforms, and infrastructure I use to build production systems.
        </p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {techStacks.map((tech) => (
          <div class="group tech-stack-card flex min-h-24 items-center gap-4 rounded-xs border border-black/10 bg-surface-muted px-4 py-4 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-md">
            {techStackIcons[tech] ? (
              <Image src={techStackIcons[tech].startsWith("http") ? techStackIcons[tech] : `https://cdn.simpleicons.org/${techStackIcons[tech]}/2259ec`} alt="" aria-hidden="true" width={32} height={32} class="h-8 w-8 shrink-0 transition-transform duration-300 ease-out group-hover:scale-110 group-hover:-rotate-3" />
            ) : (
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-text-inverse/10 text-sm font-bold text-text-inverse" aria-hidden="true">{tech.charAt(0)}</span>
            )}
            <span class="text-sm font-semibold leading-tight text-text-secondary">{tech}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="projects" class="bg-black/[.02] py-20 sm:py-24">
      <div class="mx-auto max-w-5xl px-6">
        <h2 class="text-xl font-bold text-text-secondary">
          Featured Systems
        </h2>
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
          {projects.map((p) => (
            <ProjectCard
              client:visible
              title={p.data.title}
              description={p.data.description}
              techStack={p.data.techStack}
              projectUrl={`/projects/${p.id}/`}
              githubUrl={p.data.githubUrl}
              liveUrl={p.data.liveUrl}
            />
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <h2 class="text-xl font-bold text-text-secondary">About Me</h2>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-text-primary">
        I am a Computer Science student at Ghana Communication Technology
        University (GCTU), a builder, and the co-founder of KENOL Tech. I enjoy
        turning thoughtful ideas into reliable products, whether that means
        shaping a clear user experience, designing a dependable backend, or
        keeping the infrastructure behind it running smoothly. My work spans
        cloud systems, web platforms, open-source tooling, and the many small
        decisions that make software feel simple to use.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-text-primary">
        As a Yango STEM Fellow, I care deeply about using technology to create
        practical opportunities across Africa, especially in education and
        access to useful digital services. I am happiest when I am learning
        something new, working with people who care about their craft, and
        shipping solutions that are both technically sound and genuinely
        helpful.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-3">
        <Image
          src={yangoAwardImage}
          alt="Receiving award at Yango STEM Fellowship"
          width={800}
          height={600}
          format="webp"
          class="h-56 w-full rounded-xs object-cover shadow-sm"
        />
        <Image
          src={eventImage}
          alt="Speaking at a gathering"
          width={800}
          height={600}
          format="webp"
          class="h-56 w-full rounded-xs object-cover shadow-sm"
        />
        <Image
          src={formalStandingImage}
          alt="Formal professional portrait"
          width={800}
          height={600}
          format="webp"
          class="h-56 w-full rounded-xs object-cover shadow-sm"
        />
      </div>
    </section>

    <section id="contact" class="bg-black/[.02] py-20 sm:py-24">
      <div class="mx-auto max-w-5xl px-6">
        <h2 class="text-xl font-bold text-text-secondary">Get In Touch</h2>
        <div class="mt-8 max-w-lg">
          <ContactForm client:idle />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
